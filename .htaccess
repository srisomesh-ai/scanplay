# Allow large video uploads (Hostinger honours these in most plans)
php_value upload_max_filesize 256M
php_value post_max_size 300M
php_value max_execution_time 600

# Serve .mind files as binary
AddType application/octet-stream .mind

# Protect the JSON index from direct download
<Files "accounts.json">
  Require all denied
</Files>

# Landing assets: short cache so text/translation updates show quickly
<FilesMatch "\.(html|js)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# SQLite database must never be downloadable
<Files "scanplay.db">
  Require all denied
</Files>
<FilesMatch "scanplay\.db-(wal|shm)$">
  Require all denied
</FilesMatch>

# Never serve config files
<Files "config.php">
  Require all denied
</Files>
<Files "config.sample.php">
  Require all denied
</Files>

# Backups never served over the web
<FilesMatch "\.(sqlite|db)$">
  Require all denied
</FilesMatch>

# No directory listings
Options -Indexes

# Backups folder never served
RedirectMatch 404 ^/backups/

# --- security headers (conservative; no CSP/SRI) ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
# binaries in data/bin are never served
<FilesMatch "^(ffmpeg|ffprobe|ffmpeg\.gz)$">
  Require all denied
</FilesMatch>
# no one browses the token ledger or database by URL
<FilesMatch "\.(db|sqlite|log)$">
  Require all denied
</FilesMatch>
# signed agreements and signatures are served only through the API
RedirectMatch 404 ^/data/agreements/
