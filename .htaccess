# Allow large video uploads (Hostinger honours these in most plans)
php_value upload_max_filesize 256M
php_value post_max_size 300M
php_value max_execution_time 600

# Serve .mind files as binary
AddType application/octet-stream .mind

# Protect the JSON index from direct download
<Files "accounts.json">
  Require all denied
</Files>

# Landing assets: short cache so text/translation updates show quickly
<FilesMatch "\.(html|js)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# SQLite database must never be downloadable
<Files "scanplay.db">
  Require all denied
</Files>
<FilesMatch "scanplay\.db-(wal|shm)$">
  Require all denied
</FilesMatch>

# Never serve config files
<Files "config.php">
  Require all denied
</Files>
<Files "config.sample.php">
  Require all denied
</Files>

# Backups never served over the web
<FilesMatch "\.(sqlite|db)$">
  Require all denied
</FilesMatch>

# No directory listings
Options -Indexes

# Backups folder never served
RedirectMatch 404 ^/backups/

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\")"
</IfModule>
